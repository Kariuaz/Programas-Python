import os

class Prestamo:
    def __init__(self, titulo_libro, num_dias, tarifa_dia):
        self.titulo_libro = titulo_libro
        self.num_dias = num_dias
        self.tarifa_dia = tarifa_dia
        self.total = num_dias * tarifa_dia

    def __str__(self):
        return f' -> Libro: {self.titulo_libro:<25} Días: {self.num_dias:>3} Tarifa/Día: $ {self.tarifa_dia:>6.2f} Total: $ {self.total:>7.2f}'


class Usuario:
    def __init__(self, uid, nombre_usr, correo_usr, tel_usr):
        self.uid = uid
        self.nombre_usr = nombre_usr
        self.correo_usr = correo_usr
        self.tel_usr = tel_usr
        self.lista_prestamos = list()

    def agregarPrestamo(self, prestamo):
        self.lista_prestamos.append(prestamo)

    def totalTarifas(self):
        total = 0
        for prestamo in self.lista_prestamos:
            total += prestamo.total
        return total

    def __str__(self):
        return f'Usuario -> [Nombre: {self.nombre_usr} ID: {self.uid} Correo: {self.correo_usr} Tel: {self.tel_usr} ]'


class Biblioteca:
    def __init__(self, nombre_bib, direccion, encargado_bib):
        self.nombre_bib = nombre_bib
        self.direccion = direccion
        self.encargado_bib = encargado_bib
        self.reg_usuarios = list()

    def agregarUsuario(self, usuario):
        self.reg_usuarios.append(usuario)

    def totalPrestamos(self):
        total = 0
        for usuario in self.reg_usuarios:
            total += len(usuario.lista_prestamos)
        return total

    def totalImportePrestamos(self):
        total = 0
        for usuario in self.reg_usuarios:
            total += usuario.totalTarifas()
        return total

    def __str__(self):
        return f'Biblioteca -> [Nombre: {self.nombre_bib} Domicilio: {self.direccion} Encargado: {self.encargado_bib}]'


